# Copy to backend/.env and fill in. (backend/.env is gitignored.)
# The backend reads this file (run from the backend/ directory).

# ── Wazuh ────────────────────────────────────────────────────────────────────
# Wazuh manager REST API
API_URL=https://172.16.255.1:55000
API_USER=wazuh-wui
API_PASS=MyS3cr37P450r.*-

# Wazuh indexer / OpenSearch
INDEXER_URL=https://172.16.255.1:9200
INDEXER_USER=admin
INDEXER_PASS=SecretPassword

# Leave empty to skip TLS verification of the self-signed dev certs,
# or point at root-ca.pem for proper verification.
WAZUH_CERT=

# ── Postgres (tenant registry + per-tenant settings) ─────────────────────────
# Local dev: matches the bundled docker-compose.yml (`docker compose up -d`).
DATABASE_URL=postgresql+psycopg://soc:soc@localhost:5432/soc
#
# Remote deploy: point at your existing Postgres. Tables are created automatically
# on first startup (create_all), but the role/database must exist first. Once, as
# the postgres superuser:
#   CREATE ROLE soc WITH LOGIN PASSWORD 'change-me';
#   CREATE DATABASE soc OWNER soc;
#   \c soc
#   GRANT ALL ON SCHEMA public TO soc;   -- required on PostgreSQL 15+
# then set:
#   DATABASE_URL=postgresql+psycopg://soc:change-me@localhost:5432/soc
# (Do NOT run the docker-compose Postgres on a host that already has one — it
#  would conflict on port 5432. Point DATABASE_URL at the existing server instead.)

# ── Auth (JWT + seeded admin) ────────────────────────────────────────────────
# SECRET_KEY signs JWT access tokens — set a long random value in any real deploy.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-key-change-me-in-production
# ACCESS_TOKEN_EXPIRE_MINUTES=720           # token lifetime (default 12h)
# An admin account is created on first boot only when the user table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin                         # change before any real deploy

# ── App settings (optional; sensible defaults in app/core/config.py) ─────────
# MIN_ALERT_LEVEL=7                          # global default detection threshold
# ALLOWED_ORIGINS=["http://localhost:5173"]  # CORS origins for the frontend
