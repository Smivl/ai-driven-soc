# Postgres (tenant registry + per-tenant settings).
# Local dev matches docker-compose.yml. For remote deploy, create the role/db once
# and repoint this. See backend/.env.example for the full setup notes.
DATABASE_URL=postgresql+psycopg://soc:soc@localhost:5432/soc
